        "medium": 500,
        "semibold": 600,
        "bold": 700
      },
      "lineHeight": {
        "body": 1.5,
        "heading": "normal",
        "none": 1
      },
      "letterSpacing": {
        "heading": "-0.01em",
        "uppercase": "0.14em",
        "displayHeading": "-0.025em"
      }
    },
    "spacing": {
      "scale": {
        "0.25": "0.25rem",
        "0.5": "0.5rem",
        "0.75": "0.75rem",
        "1": "1rem",
        "1.5": "1.5rem",
        "2": "2rem",
