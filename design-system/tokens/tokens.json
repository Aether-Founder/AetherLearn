        "hover": "150-200ms",
        "dropdown": "200ms",
        "success": "1.2s",
        "shimmer": "1.25s",
        "reflection": "2.4s"
      },
      "easing": {
        "hover": "ease-in-out",
        "dropdown": "ease-in-out",
        "confetti": "ease-in",
        "reflection": "ease-in-out"
      }
    },
    "breakpoint": {
      "sm": "640px",
      "md": "768px",
      "lg": "1024px",
      "xl": "1280px"
    },
    "zIndex": {
      "dropdown": 20,
      "sidebar": 40,
      "modal": 50,
      "loader": 9999
    },
    "touchTarget": {
      "minimumHeight": "44px"
    }
