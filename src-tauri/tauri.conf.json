{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Aether Learn",
  "version": "0.1.0",
  "identifier": "com.aether.learn",
  "build": {
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "Aether Learn",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#1a1d2e",
        "hiddenTitle": false,
        "titleBarStyle": "Visible"
      }
    ],
    "security": {
      "csp": null,
      "dangerousDisableAssetCspModification": false
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "msi", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Education",
    "shortDescription": "Study platform for VWO and HAVO students",
    "longDescription": "Aether is the study platform for VWO and HAVO: study sets, lessons, agenda and practice progress per subject in one place.",
    "publisher": "Aether Learn",
    "copyright": "Copyright © 2024 Aether Learn"
  },
  "plugins": {
    "store": {
      "allowedPaths": ["$APPDATA", "$APPDATA/**"],
      "autoSave": true
    }
  }
}
