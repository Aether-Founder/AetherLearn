{
  "name": "artisan-daemon",
  "version": "1.0.0",
  "description": "Local daemon for processing Artisan uploads",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "ts-node src/index.ts start",
    "status": "ts-node src/index.ts status",
    "deliver": "ts-node src/index.ts deliver",
    "dev": "ts-node-dev --respawn src/index.ts"
  },
  "keywords": ["artisan", "supabase", "daemon"],
  "author": "AetherLearn",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "commander": "^11.1.0",
    "chalk": "^4.1.2",
    "ora": "^5.4.1",
    "cli-table3": "^0.6.3",
    "node-notifier": "^10.0.1",
    "zod": "^3.22.4",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/node-notifier": "^8.0.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.2"
  }
}
