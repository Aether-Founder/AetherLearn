+
+    let allLoadedSets = [...PRELOADED_SETS];
+    let currentLeerset = null;
+
+    /* --------------------------------------------------------------------------
+       4. GRID HOME PAGE RENDERING
+       -------------------------------------------------------------------------- */
+    function renderSetsGrid(filterText = '') {
+      const container = document.getElementById('setsGridContainer');
+      container.innerHTML = '';
+
+      const filtered = allLoadedSets.filter(s => {
+        const query = filterText.toLowerCase();
+        return s.siteMetadata.title.toLowerCase().includes(query) ||
+               s.subject.toLowerCase().includes(query) ||
+               s.siteMetadata.description.toLowerCase().includes(query);
+      });
+
+      filtered.forEach(s => {
+        const card = document.createElement('div');
+        card.className = 'set-card';
+        card.onclick = () => openLeerset(s);
+
+        const secCount = s.sections ? s.sections.length : 0;
+        card.innerHTML = `
+          <div>
+            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
+              <span class="badge">${s.subject}</span>
