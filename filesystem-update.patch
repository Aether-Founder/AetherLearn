+    
+    .controls {
+      display: flex;
+      gap: 10px;
+      margin-top: 20px;
+      flex-wrap: wrap;
+    }
+    
+    .btn {
+      padding: 10px 20px;
+      border: none;
+      border-radius: 8px;
+      cursor: pointer;
+      font-size: 14px;
+      font-weight: bold;
+      transition: all 0.3s ease;
+    }
+    
+    .btn:hover {
+      transform: translateY(-2px);
+      box-shadow: 0 5px 15px rgba(0,0,0,0.2);
+    }
+    
+    .btn-head {
+      background: linear-gradient(135deg, #ff6b6b, #ee5a5a);
+      color: white;
+    }
+    
+    .btn-tail {
+      background: linear-gradient(135deg, #feca57, #ff9f43);
+      color: white;
+    }
+    
+    .btn-protein {
+      background: linear-gradient(135deg, #a29bfe, #6c5ce7);
+      color: white;
+    }
+    
+    .btn-receptor {
+      background: linear-gradient(135deg, #fd79a8, #e84393);
+      color: white;
+    }
+    
+    .btn-channel {
+      background: linear-gradient(135deg, #00cec9, #00b894);
+      color: white;
+    }
+    
+    .btn-reset {
+      background: #636e72;
+      color: white;
+    }
+  </style>
+</head>
+<body>
+  <div class="container">
+    <h1>🧬 De bouw van een celmembraan</h1>
+    
+    <div class="membrane-container">
+      <div class="membrane-visual" id="membraneVisual">
+        <div class="water-label water-outside">💧 Buiten de cel (waterig milieu)</div>
+        <div class="water-label water-inside">💧 Binnen de cel (cytoplasma)</div>
+      </div>
+      
+      <div class="legend">
+        <div class="legend-item">
+          <div class="legend-color" style="background: linear-gradient(135deg, #ff6b6b, #ee5a5a);"></div>
+          <span>Fosfaatgroep (hydrofiel)</span>
+        </div>
+        <div class="legend-item">
+          <div class="legend-color" style="background: linear-gradient(135deg, #feca57, #ff9f43);"></div>
+          <span>Vetzuurstaarten (hydrofoob)</span>
+        </div>
+        <div class="legend-item">
+          <div class="legend-color" style="background: linear-gradient(135deg, #a29bfe, #6c5ce7);"></div>
+          <span>Membraaneiwitten</span>
+        </div>
+        <div class="legend-item">
+          <div class="legend-color" style="background: linear-gradient(135deg, #fd79a8, #e84393);"></div>
+          <span>Receptoreiwitten</span>
+        </div>
+        <div class="legend-item">
+          <div class="legend-color" style="background: linear-gradient(135deg, #00cec9, #00b894);"></div>
+          <span>Transportkanaaltjes</span>
+        </div>
+      </div>
+      
+      <div class="controls">
+        <button class="btn btn-head" onclick="highlightPart('head')">Toon koppen</button>
+        <button class="btn btn-tail" onclick="highlightPart('tail')">Toon staarten</button>
+        <button class="btn btn-protein" onclick="highlightPart('protein')">Toon eiwitten</button>
+        <button class="btn btn-receptor" onclick="highlightPart('receptor')">Toon receptoren</button>
+        <button class="btn btn-channel" onclick="highlightPart('channel')">Toon kanaaltjes</button>
+        <button class="btn btn-reset" onclick="resetHighlight()">Reset</button>
+      </div>
+    </div>
+    
+    <div class="info-panel" id="infoPanel">
+      <h3>Klik op een onderdeel voor meer informatie</h3>
+      <p>Het celmembraan bestaat uit een dubbele laag fosfolipiden met daartussen eiwitmoleculen. De fosfaatgroepen zijn hydrofiel (waterminnend) en wijzen naar het waterige milieu. De vetzuurstaarten zijn hydrofoob (waterafstotend) en keren zich van water af.</p>
+    </div>
+  </div>
+  
+  <script>
+    const membraneVisual = document.getElementById('membraneVisual');
+    
+    function createPhospholipid(x, y, flipped = false) {
+      const phospholipid = document.createElement('div');
+      phospholipid.className = 'phospholipid';
+      phospholipid.style.left = x + 'px';
+      phospholipid.style.top = y + 'px';
+      
+      const head = document.createElement('div');
+      head.className = 'head';
+      head.onclick = () => showInfo('head');
+      
+      const tails = document.createElement('div');
+      tails.className = 'tails';
+      
+      if (flipped) {
+        tails.style.top = 'auto';
+        tails.style.bottom = '25px';
+        tails.style.transform = 'rotate(180deg)';
+      }
+      
+      const tail1 = document.createElement('div');
+      tail1.className = 'tail';
+      tail1.onclick = () => showInfo('tail');
+      
+      const tail2 = document.createElement('div');
+      tail2.className = 'tail';
+      tail2.onclick = () => showInfo('tail');
+      
+      tails.appendChild(tail1);
+      tails.appendChild(tail2);
+      phospholipid.appendChild(head);
+      phospholipid.appendChild(tails);
+      
+      return phospholipid;
+    }
+    
+    function createProtein(x, y, type = 'normal') {
+      const protein = document.createElement('div');
+      protein.className = 'protein ' + (type === 'receptor' ? 'receptor-protein' : type === 'channel' ? 'channel-protein' : ''));
+      protein.style.left = x + 'px';
+      protein.style.top = y + 'px';
+      protein.textContent = type === 'receptor' ? 'R' : type === 'channel' ? 'K' : 'E';
+      protein.onclick = () => showInfo(type === 'receptor' ? 'receptor' : type === 'channel' ? 'channel' : 'protein');
+      return protein;
+    }
+    
+    function initMembrane() {
+      // Upper layer phospholipids (heads up)
+      for (let i = 0; i < 12; i++) {
+        const x = 50 + i * 70;
+        const y = 140;
+        membraneVisual.appendChild(createPhospholipid(x, y, false));
+      }
+      
+      // Lower layer phospholipids (heads down)
+      for (let i = 0; i < 12; i++) {
+        const x = 50 + i * 70;
+        const y = 220;
+        membraneVisual.appendChild(createPhospholipid(x, y, true));
+      }
+      
+      // Membrane proteins
+      membraneVisual.appendChild(createProtein(150, 160, 'normal'));
+      membraneVisual.appendChild(createProtein(350, 150, 'receptor'));
+      membraneVisual.appendChild(createProtein(550, 155, 'channel'));
+      membraneVisual.appendChild(createProtein(750, 160, 'normal'));
+    }
+    
+    const infoData = {
+      head: {
+        title: "🔴 Fosfaatgroep (Hydrofiel)",
+        description: "De kop van een fosfolipidemolecuul bestaat uit een fosfaatgroep die in water oplosbaar is (hydrofiel of polair). De koppen wijzen naar het waterige milieu, zowel aan de buitenkant als aan de binnenkant van de cel."
+      },
+      tail: {
+        title: "🟡 Vetzuurstaarten (Hydrofoob)",
+        description: "De staarten van een fosfolipidemolecuul bestaan uit twee lange vetzuurmoleculen die waterafstotend zijn (hydrofoob of apolair). De staarten keren zich van water af en trekken elkaar aan, waardoor een dubbele laag ontstaat."
+      },
+      protein: {
+        title: "🟣 Membraaneiwitten",
+        description: "Eiwitmoleculen die in het celmembraan zijn ingebed. Veel van deze eiwitten spelen een rol bij het transport van stoffen in en uit de cel. Ze kunnen ook enzymatische functies hebben."
+      },
+      receptor: {
+        title: "🩷 Receptoreiwitten",
+        description: "Eiwitten met daaraan koolhydraatketens die een rol spelen bij de herkenning van de cel door eiwitten in het membraan van andere cellen. Ze kunnen signalen uit de omgeving waarnemen en doorgeven aan de cel."
+      },
+      channel: {
+        title: "🟢 Transportkanaaltjes",
+        description: "Speciale eiwitten die een kanaal vormen door het membraan. Ze regelen de opname en afgifte van specifieke stoffen zoals ionen (Na+, K+, Ca+) of water (aquaporines)."
+      }
+    };
+    
+    function showInfo(part) {
+      const panel = document.getElementById('infoPanel');
+      const info = infoData[part];
+      panel.innerHTML = `
+        <h3>${info.title}</h3>
+        <p>${info.description}</p>
+      `;
+    }
+    
+    function highlightPart(part) {
+      resetHighlight();
+      const elements = membraneVisual.querySelectorAll('.phospholipid, .protein');
+      elements.forEach(el => {
+        if (part === 'head' && el.querySelector('.head')) {
+          el.querySelector('.head').style.boxShadow = '0 0 20px rgba(255, 107, 107, 0.8)';
+        } else if (part === 'tail' && el.querySelector('.tail')) {
+          el.querySelectorAll('.tail').forEach(t => t.style.boxShadow = '0 0 20px rgba(254, 202, 87, 0.8)');
+        } else if (part === 'protein' && el.classList.contains('protein') && !el.classList.contains('receptor-protein') && !el.classList.contains('channel-protein')) {
+          el.style.boxShadow = '0 0 20px rgba(162, 155, 254, 0.8)';
+        } else if (part === 'receptor' && el.classList.contains('receptor-protein')) {
+          el.style.boxShadow = '0 0 20px rgba(253, 121, 168, 0.8)';
+        } else if (part === 'channel' && el.classList.contains('channel-protein')) {
+          el.style.boxShadow = '0 0 20px rgba(0, 206, 201, 0.8)';
+        }
+      });
+      showInfo(part);
+    }
+    
+    function resetHighlight() {
+      const elements = membraneVisual.querySelectorAll('.head, .tail, .protein');
+      elements.forEach(el => el.style.boxShadow = '');
+    }
+    
+    initMembrane();
+  </script>
+</body>
+</html>
