+      font-size: 12px;
+      font-weight: bold;
+    }
+    
+    .protein:hover {
+      transform: scale(1.1);
+      box-shadow: 0 5px 15px rgba(108, 92, 231, 0.4);
+    }
+    
+    .receptor-protein {
+      background: linear-gradient(135deg, #fd79a8, #e84393);
+    }
+    
+    .channel-protein {
+      background: linear-gradient(135deg, #00cec9, #00b894);
