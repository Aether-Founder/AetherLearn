+
+      const filtered = allLoadedSets.filter(s => {
+        const query = filterText.toLowerCase();
+        return s.siteMetadata.title.toLowerCase().includes(query) ||
+               s.subject.toLowerCase().includes(query) ||
+               s.siteMetadata.description.toLowerCase().includes(query);
+      });
+
+      filtered.forEach(s => {
+        const card = document.createElement('div');
+        card.className = 'set-card';
+        card.onclick = () => openLeerset(s);
+
+        const secCount = s.sections ? s.sections.length : 0;
+        card.innerHTML = `
+          <div>
+            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
+              <span class="badge">${s.subject}</span>
+              <span style="font-size: 12px; font-family: var(--font-mono); color: var(--muted-foreground);">${secCount} ${I18N[currentLang].sections_count}</span>
+            </div>
+            <h3 style="font-size: 22px; font-family: var(--font-serif); font-weight: 600; line-height: 1.25; margin-bottom: 0.5rem;">
+              ${s.siteMetadata.title}
+            </h3>
+            <p style="font-size: 13.5px; color: var(--muted-foreground); line-height: 1.5;">
+              ${s.siteMetadata.description}
+            </p>
+          </div>
+          <div style="display: flex; justify-content: flex-end;">
+            <span class="btn btn-secondary" style="font-size: 12.5px; font-weight: 500;">
+              ${I18N[currentLang].open_set}
+            </span>
+          </div>
+        `;
+        container.appendChild(card);
+      });
+
+      document.getElementById('totalSetsBadge').textContent = `${allLoadedSets.length} Learning Sets`;
+    }
+
+    function filterSetsGrid(val) {
+      renderSetsGrid(val);
+    }
+
+    /* --------------------------------------------------------------------------
+       5. LEERSET VIEWER RENDERING (FREELY RENDERED, SECTIONS ON LEFT)
+       -------------------------------------------------------------------------- */
+    function openLeerset(setData) {
+      currentLeerset = setData;
+
+      // Update Header
+      document.getElementById('homeHeader').style.display = 'none';
+      document.getElementById('leersetHeader').style.display = 'block';
+      document.getElementById('topModeSwitcher').style.display = 'inline-flex';
+      document.getElementById('viewerTitle').textContent = setData.siteMetadata.title;
+      document.getElementById('viewerDesc').textContent = setData.siteMetadata.description;
+
+      // Toggle views
+      document.getElementById('viewHome').style.display = 'none';
+      document.getElementById('viewLeerset').style.display = 'block';
+
+      // Render Left Sidebar Sections
+      renderSidebarNav(setData.sections);
+
+      // Render Main Content
+      renderTextbookSections(setData.sections);
+
+      // Summary text
+      document.getElementById('summaryContent').innerHTML = renderSimpleMarkdown(setData.summary || "No summary provided.");
+
+      // Reset to top and Explanation mode
+      setMode('simple');
+      window.scrollTo({ top: 0, behavior: 'smooth' });
+
+      // Run KaTeX Math
+      setTimeout(() => {
+        if (window.renderMathInElement) {
+          renderMathInElement(document.getElementById('viewLeerset'), {
+            delimiters: [
+              { left: '$$', right: '$$', display: true },
+              { left: '$', right: '$', display: false }
+            ],
+            throwOnError: false
+          });
+        }
+      }, 50);
+    }
+
+    function goToHome() {
+      document.getElementById('viewLeerset').style.display = 'none';
+      document.getElementById('viewHome').style.display = 'block';
+      document.getElementById('homeHeader').style.display = 'block';
+      document.getElementById('leersetHeader').style.display = 'none';
+      document.getElementById('topModeSwitcher').style.display = 'none';
+      window.scrollTo({ top: 0, behavior: 'smooth' });
+    }
+
+    function renderSidebarNav(sections = []) {
+      const nav = document.getElementById('sidebarNavLinks');
+      nav.innerHTML = '';
+
+      sections.forEach((sec, idx) => {
+        const link = document.createElement('a');
+        link.href = `#${sec.id}`;
+        link.className = `sidebar-link ${idx === 0 ? 'active' : ''}`;
+        link.style.display = 'flex';
+        link.style.alignItems = 'center';
+        link.style.gap = '0.5rem';
+        link.style.padding = '0.45rem 0.6rem';
+        link.style.borderRadius = '4px';
+        link.style.textDecoration = 'none';
+        link.style.color = (idx === 0 ? 'var(--foreground)' : 'var(--muted-foreground)');
+        link.style.fontWeight = (idx === 0 ? '600' : '400');
+        link.style.backgroundColor = (idx === 0 ? 'var(--secondary)' : 'transparent');
+        link.style.transition = 'all 0.15s ease';
+
+        link.innerHTML = `
+          <svg style="width: 14px; height: 14px; flex-shrink: 0; color: var(--muted-foreground);" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
+          <span style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">${sec.title}</span>
+        `;
+        nav.appendChild(link);
+      });
+    }
+
+    function renderTextbookSections(sections = []) {
+      const container = document.getElementById('textbookSectionsContainer');
+      container.innerHTML = '';
+
+      sections.forEach(sec => {
+        const secEl = document.createElement('section');
+        secEl.id = sec.id;
+        secEl.style.scrollMarginTop = '3.5rem';
+        secEl.style.marginBottom = '3.5rem';
+
+        // Title
+        const headingBox = document.createElement('div');
+        headingBox.style.paddingBottom = '0.75rem';
+        headingBox.style.borderBottom = '1px solid var(--border)';
+        headingBox.style.marginBottom = '1.5rem';
+        headingBox.innerHTML = `
+          <h2 style="font-size: 30px; font-family: var(--font-serif); font-weight: 500;">
+            ${sec.title}
+          </h2>
+        `;
+        secEl.appendChild(headingBox);
+
+        // Card Article
+        const card = document.createElement('article');
+        card.className = 'card';
+        card.style.padding = '1.75rem';
+        card.style.marginBottom = '1.5rem';
+
+        if (sec.goal) {
+          card.innerHTML += `
+            <div class="goal-callout">
+              <strong>GOAL</strong> &rarr; ${sec.goal}
+            </div>
+          `;
+        }
+
+        if (sec.content) {
+          card.innerHTML += `<div style="font-size: 16px; line-height: 1.75;">${renderSimpleMarkdown(sec.content)}</div>`;
+        }
+        secEl.appendChild(card);
+
+        // Exercises Accordion
+        if (sec.questions && sec.questions.length > 0) {
+          const exCard = document.createElement('div');
+          exCard.className = 'exercise-card';
+
+          const exHeader = document.createElement('div');
+          exHeader.className = 'exercise-card-header';
+          exHeader.innerHTML = `
+            <div>
+              <h3 style="font-size: 19px; font-family: var(--font-serif); margin: 0;">${sec.title} — Questions</h3>
+              <p style="font-size: 12.5px; color: var(--muted-foreground); margin-top: 2px;">Click any question to view its step-by-step solution.</p>
+            </div>
+            <button class="btn btn-secondary" style="font-size: 11.5px; padding: 0.35rem 0.65rem;" onclick="toggleAllInSection('${sec.id}')">
+              Toggle All
+            </button>
+          `;
+          exCard.appendChild(exHeader);
+
+          sec.questions.forEach((q, qIdx) => {
+            const qRow = document.createElement('div');
+            qRow.className = `q-row ${qIdx === 0 ? 'open' : ''}`;
+            qRow.innerHTML = `
+              <button class="q-btn" onclick="this.closest('.q-row').classList.toggle('open')">
+                <svg class="q-chevron" style="width: 14px; height: 14px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
+                <span class="q-num">${q.number}</span>
+                <span class="q-text">${q.text}</span>
+              </button>
+              <div class="q-answer-container">
+                <div style="color: var(--foreground); font-size: 14px; line-height: 1.6;">
+                  <strong>Solution:</strong> ${q.answer}
+                </div>
+              </div>
+            `;
+            exCard.appendChild(qRow);
+          });
+
+          secEl.appendChild(exCard);
+        }
+
+        container.appendChild(secEl);
+      });
+    }
+
+    function toggleAllInSection(sectionId) {
+      const sec = document.getElementById(sectionId);
+      if (!sec) return;
+      const rows = sec.querySelectorAll('.q-row');
+      const anyClosed = Array.from(rows).some(r => !r.classList.contains('open'));
+      rows.forEach(r => {
+        if (anyClosed) r.classList.add('open');
+        else r.classList.remove('open');
+      });
+    }
+
+    function renderSimpleMarkdown(text = '') {
+      return text
+        .replace(/^### (.*$)/gim, '<h3 style="font-size:22px; font-family:var(--font-serif); margin:1.5rem 0 0.5rem 0;">$1</h3>')
+        .replace(/^## (.*$)/gim, '<h2 style="font-size:26px; font-family:var(--font-serif); margin:1.75rem 0 0.6rem 0;">$1</h2>')
+        .replace(/\*\*(.*?)\*\*/gim, '<strong>$1</strong>')
+        .replace(/\*(.*?)\*/gim, '<em>$1</em>')
+        .replace(/\n\n/gim, '</p><p style="margin-bottom:1rem;">')
+        .replace(/^- (.*$)/gim, '<li style="margin-left:1.5rem; margin-bottom:0.25rem;">$1</li>');
+    }
+
+    /* --------------------------------------------------------------------------
+       6. MODE SWITCHING CONTROLLER (Explanation / Summary / Learn)
+       -------------------------------------------------------------------------- */
+    function setMode(mode) {
+      document.querySelectorAll('#topModeSwitcher .mode-tab-btn').forEach(b => b.classList.remove('active'));
+
+      const tbContainer = document.getElementById('textbookSectionsContainer');
+      const sumContainer = document.getElementById('summaryModeView');
+
+      if (mode === 'summary') {
+        document.getElementById('btnModeSummary').classList.add('active');
+        tbContainer.style.display = 'none';
+        sumContainer.style.display = 'block';
+      } else {
+        document.getElementById('btnModeSimple').classList.add('active');
+        tbContainer.style.display = 'block';
+        sumContainer.style.display = 'none';
+      }
+    }
+
+    /* --------------------------------------------------------------------------
+       7. CUSTOM JSON LOADERS (PASTE & LOCAL FILE UPLOAD)
+       -------------------------------------------------------------------------- */
+    function toggleJsonPasteModal() {
+      const drawer = document.getElementById('jsonPasteDrawer');
+      drawer.style.display = (drawer.style.display === 'none' ? 'block' : 'none');
+    }
+
+    function loadPastedJson() {
+      const val = document.getElementById('jsonPasteArea').value;
+      if (!val.trim()) {
+        alert("Please paste valid JSON text.");
+        return;
+      }
+      try {
+        const parsed = JSON.parse(val);
+        processAndOpenCustomJson(parsed, "Pasted JSON Set");
+        toggleJsonPasteModal();
+      } catch (err) {
+        alert("Invalid JSON format: " + err.message);
+      }
+    }
+
+    function handleFileUpload(e) {
+      const file = e.target.files[0];
+      if (!file) return;
+
+      const reader = new FileReader();
+      reader.onload = (event) => {
+        try {
+          const parsed = JSON.parse(event.target.result);
+          processAndOpenCustomJson(parsed, file.name.replace(/\.json$/i, ''));
+        } catch (err) {
+          alert("Error parsing uploaded JSON: " + err.message);
+        }
+      };
+      reader.readAsText(file);
+    }
+
+    function processAndOpenCustomJson(data, fallbackTitle = "Custom Set") {
+      const setObj = {
+        id: `custom-${Date.now()}`,
+        subject: "Custom Leerset",
+        siteMetadata: {
+          title: data.siteMetadata?.title || fallbackTitle,
+          description: data.siteMetadata?.description || "Loaded from custom JSON file."
+        },
+        summary: data.summary || "",
+        sections: data.sections || []
+      };
+
+      allLoadedSets.unshift(setObj);
+      renderSetsGrid();
+      openLeerset(setObj);
+    }
+
+    /* --------------------------------------------------------------------------
+       8. SCROLLSPY & SCROLL-TO-TOP OBSERVER
+       -------------------------------------------------------------------------- */
+    window.addEventListener('scroll', () => {
+      const scrollTopBtn = document.getElementById('scrollTopBtn');
+      if (window.scrollY > 350) {
+        scrollTopBtn.style.display = 'inline-flex';
+      } else {
+        scrollTopBtn.style.display = 'none';
+      }
+
+      if (document.getElementById('viewLeerset').style.display !== 'none') {
+        const sections = document.querySelectorAll('#textbookSectionsContainer section[id]');
+        const links = document.querySelectorAll('#sidebarNavLinks .sidebar-link');
+        let currentId = '';
+
+        sections.forEach(s => {
+          const top = s.offsetTop;
+          const height = s.offsetHeight;
+          if (window.scrollY + 120 >= top && window.scrollY + 120 < top + height) {
+            currentId = s.getAttribute('id');
+          }
+        });
+
+        if (currentId) {
+          links.forEach(l => {
+            if (l.getAttribute('href') === `#${currentId}`) {
+              l.style.color = 'var(--foreground)';
+              l.style.backgroundColor = 'var(--secondary)';
+              l.style.fontWeight = '600';
+            } else {
+              l.style.color = 'var(--muted-foreground)';
+              l.style.backgroundColor = 'transparent';
+              l.style.fontWeight = '400';
+            }
+          });
+        }
+      }
+    });
+
+    /* --------------------------------------------------------------------------
+       9. INITIALIZATION
+       -------------------------------------------------------------------------- */
+    document.addEventListener('DOMContentLoaded', () => {
+      // Default to System or prefers-color-scheme
+      const prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
+      applyThemeMode(prefersDark);
+
+      // Default language: English
+      setLanguage('en');
+
+      // Populate sets grid
+      renderSetsGrid();
+    });
+  </script>
+</body>
+</html>
