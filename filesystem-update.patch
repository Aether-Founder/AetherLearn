+    .badge.badge-serif {
+      font-family: var(--font-serif);
+      font-size: 13px;
+      font-weight: 500;
+    }
+
+/* Summary mode view: borderless and spacious */
+    .summary-view {
+      border: none;
+      background-color: transparent;
+      border-radius: 0;
+      box-shadow: none;
+      padding: 1.5rem 0.5rem 3.5rem 0.5rem;
