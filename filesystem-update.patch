@@ -0,0 +1,1972 @@
+<!DOCTYPE html>
+<html lang="nl">
+<head>
+<meta charset="UTF-8">
+<meta name="viewport" content="width=device-width, initial-scale=1.0">
+<meta name="description" content="Aether tekent atoommodellen en structuurformules stap voor stap, met uitleg.">
+<title>Aether - Atomen &amp; Moleculen</title>
+<link rel="preconnect" href="https://fonts.googleapis.com">
+<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
+<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
+<style>
+:root{
+  --background:#E8EEFD;--foreground:#020817;--card:#E8EEFD;--card-alt:#FFFFFF;
+  --border:rgba(2,8,23,0.18);--border-solid:#E2E8F0;--muted:#F1F5F9;--muted-foreground:#64748B;
+  --secondary:#F1F5F9;--secondary-foreground:#020817;--primary:#0F172A;--primary-hover:#1E293B;
+  --primary-foreground:#F8FAFC;--code-bg:#E2E8F0;--focus-ring:rgba(15,23,42,0.2);
+  --font-sans:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;
+  --font-serif:'Cormorant Garamond',Georgia,Cambria,serif;
+  --font-mono:'JetBrains Mono',ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;
+}
+html.dark{
+  --background:#020817;--foreground:#F8FAFC;--card:#020817;--card-alt:#0B1120;
+  --border:#1E293B;--border-solid:#1E293B;--muted:#1E293B;--muted-foreground:#94A3B8;
+  --secondary:#1E293B;--secondary-foreground:#F8FAFC;--primary:#F8FAFC;--primary-hover:#E2E8F0;
+  --primary-foreground:#020817;--code-bg:#1E293B;--focus-ring:rgba(248,250,252,0.25);
+}
+*{box-sizing:border-box}
+html{color-scheme:light;scroll-behavior:smooth;background:var(--background)}
+html.dark{color-scheme:dark}
+body{
+  margin:0;min-width:320px;min-height:100vh;color:var(--foreground);
+  background:radial-gradient(circle at 10% 0%,rgba(255,255,255,.32),transparent 28rem),var(--background);
+  font-family:var(--font-sans);font-size:15px;line-height:1.6;
+}
+html.dark body{background:radial-gradient(circle at 10% 0%,rgba(148,163,184,.08),transparent 28rem),var(--background)}
+body,button,input,.card-base,.card-alt,.site-nav,.step-card,.tab-btn,.key-button{
+  transition:background-color .25s ease,color .25s ease,border-color .25s ease;
+}
+button,input{font:inherit}button{color:inherit}
+.container-custom{width:100%;max-width:1100px;margin:0 auto;padding:0 1.25rem}
+
+/* ---------- nav ---------- */
+.site-nav{position:sticky;top:0;z-index:50;background-color:color-mix(in srgb,var(--background) 88%,transparent);
+  border-bottom:1px solid var(--border);backdrop-filter:blur(10px);padding:.75rem 0}
+.nav-inner{display:flex;align-items:center;justify-content:space-between;gap:1rem}
+.nav-brand{display:flex;align-items:center;min-width:0}
+.wordmark{font-family:var(--font-serif);font-size:25px;font-weight:600;letter-spacing:-.01em;line-height:1}
+.nav-context{margin-left:.8rem;padding-left:.8rem;border-left:1px solid var(--border);color:var(--muted-foreground);font-size:12px}
+
+/* ---------- buttons ---------- */
+.btn-primary,.btn-secondary,.btn-icon{border-radius:4px;font-size:13px;font-weight:500;font-family:var(--font-sans);
+  transition:all .15s ease;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;gap:.5rem}
+.btn-primary{background-color:var(--primary);color:var(--primary-foreground);border:1px solid transparent;padding:.65rem 1rem}
+.btn-primary:hover{background-color:var(--primary-hover)}
+.btn-secondary{background-color:transparent;color:var(--foreground);border:1px solid var(--border);padding:.6rem .95rem}
+.btn-secondary:hover{background-color:var(--secondary)}
+.btn-icon{width:38px;height:38px;padding:.5rem;border:1px solid var(--border);background:transparent;color:var(--muted-foreground)}
+.btn-icon:hover{color:var(--foreground);background-color:var(--secondary)}
+button:active{transform:scale(.98);opacity:.95}
+button:disabled{opacity:.42;cursor:not-allowed;transform:none}
+button:focus-visible,input:focus-visible{outline:3px solid var(--focus-ring);outline-offset:2px}
+
+/* ---------- head ---------- */
+.page-head{padding:3rem 0 1.75rem;max-width:780px}
+.eyebrow{margin:0 0 .5rem;color:var(--muted-foreground);font-family:var(--font-mono);font-size:11px;font-weight:500;
+  letter-spacing:.08em;text-transform:uppercase}
+h1,h2,h3,h4{font-family:var(--font-serif);font-weight:500;letter-spacing:-.01em}
+h1{margin:0;font-size:clamp(40px,7vw,60px);line-height:.98}
+.page-head h1 span{display:block;margin-top:.45rem;font-size:clamp(25px,4vw,37px);color:var(--muted-foreground)}
+.page-intro{max-width:660px;margin:1.1rem 0 0;color:var(--muted-foreground);font-size:16px;line-height:1.75}
+main{padding-bottom:4rem}
+
+/* ---------- cards & sections ---------- */
+.card-base{background-color:var(--card);border:1px solid var(--border);border-radius:6px}
+.card-alt{background-color:var(--card-alt);border:1px solid var(--border);border-radius:6px}
+.composer{overflow:hidden}
+.composer-section{padding:clamp(1.1rem,3vw,1.75rem);border-top:1px solid var(--border)}
+.composer-section:first-child{border-top:0}
+.section-heading{display:flex;align-items:flex-start;gap:1rem;margin-bottom:1rem}
+.step-number{flex:0 0 auto;display:grid;place-items:center;width:29px;height:29px;margin-top:1px;
+  border:1px solid var(--border);border-radius:50%;font-family:var(--font-mono);font-size:11px;font-weight:500}
+.section-heading h2{margin:0;font-size:clamp(23px,3vw,28px);line-height:1.15}
+.section-heading p{margin:.25rem 0 0;color:var(--muted-foreground);font-size:13px}
+.micro-label{color:var(--muted-foreground);font-size:11px;font-weight:600;letter-spacing:.05em;text-transform:uppercase}
+
+/* ---------- tabs (mode switcher) ---------- */
+.tab-bar{display:flex;gap:.25rem;padding:.25rem;background-color:var(--secondary);border:1px solid var(--border);
+  border-radius:8px;overflow-x:auto}
+.tab-btn{display:inline-flex;align-items:center;gap:.4rem;padding:.5rem .85rem;font-size:13px;font-weight:500;
+  border-radius:6px;border:1px solid transparent;background:transparent;color:var(--muted-foreground);cursor:pointer;
+  white-space:nowrap;transition:all .15s ease}
+.tab-btn:hover{color:var(--foreground)}
+.tab-btn.active{background-color:var(--background);color:var(--foreground);border-color:var(--border);
+  box-shadow:0 1px 3px rgba(0,0,0,.05)}
+.mode-desc{margin:.85rem 0 0;color:var(--muted-foreground);font-size:13px}
+
+/* ---------- input ---------- */
+.input-row{display:flex;gap:.5rem;align-items:stretch}
+.text-input{flex:1;min-width:0;padding:.75rem 1rem;font-size:16px;font-family:var(--font-sans);color:var(--foreground);
+  background-color:var(--card-alt);border:1px solid var(--border);border-radius:6px;outline:none;transition:border-color .15s ease}
+.text-input::placeholder{color:var(--muted-foreground);opacity:.7}
+.text-input:focus{border-color:var(--primary);box-shadow:0 0 0 3px var(--focus-ring)}
+.suggestions{display:flex;flex-wrap:wrap;gap:.35rem;margin-top:.6rem;min-height:0}
+.sugg{padding:.25rem .55rem;border:1px solid var(--border);border-radius:4px;background:transparent;cursor:pointer;
+  font-size:12px;color:var(--muted-foreground);transition:all .15s ease}
+.sugg:hover{color:var(--foreground);background:var(--secondary)}
+.sugg b{color:var(--foreground);font-family:Cambria,'Times New Roman',serif;font-size:13px}
+
+/* ---------- keyboard ---------- */
+.keyboard{display:grid;grid-template-columns:1.35fr 1fr;gap:.85rem 1.1rem;margin-top:1rem}
+.key-group h3{margin:0 0 .45rem;color:var(--muted-foreground);font-family:var(--font-sans);font-size:11px;
+  font-weight:600;letter-spacing:.05em;text-transform:uppercase}
+.key-grid{display:flex;flex-wrap:wrap;gap:.38rem}
+.key-button{min-width:42px;min-height:38px;padding:.42rem .6rem;color:var(--foreground);background:transparent;
+  border:1px solid var(--border);border-radius:4px;font-family:Cambria,'Times New Roman',var(--font-serif);
+  font-size:17px;line-height:1;cursor:pointer;transition:all .15s ease}
+.key-button:hover{background:var(--secondary);border-color:var(--foreground)}
+.key-button.structure{min-width:58px;font-family:var(--font-sans);font-size:12px;font-weight:500}
+.more-toggle{margin-top:1rem;display:inline-flex;align-items:center;gap:.5rem;padding:.6rem .9rem;color:var(--foreground);
+  background:var(--secondary);border:1px solid var(--border);border-radius:4px;font-size:13px;font-weight:500;cursor:pointer}
+.more-toggle:hover{background:var(--card-alt)}
+.more-toggle .chev{transition:transform .2s ease;color:var(--muted-foreground)}
+.more-toggle.open .chev{transform:rotate(90deg)}
+.more-panel{display:none;margin-top:.75rem;padding:1rem;background:var(--secondary);border:1px solid var(--border);border-radius:6px}
+.more-panel.open{display:block;animation:slideDown .25s ease}
+.pt-scroll{overflow-x:auto;padding-bottom:.4rem}
+.periodic{display:grid;grid-template-columns:repeat(18,minmax(30px,1fr));grid-auto-rows:minmax(34px,auto);
+  gap:3px;min-width:730px}
+.pt-cell{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1px;padding:2px 0;
+  border:1px solid var(--border);border-radius:3px;background:var(--card-alt);cursor:pointer;line-height:1;transition:all .12s ease}
+.pt-cell:hover,.pt-cell:focus-visible{background:var(--primary);color:var(--primary-foreground);border-color:var(--primary)}
