+          }
+          if (raw.slice(i, i + 2).toLowerCase() === 'pi') {
+            tokens.push({ type: 'sym', name: 'π' }); i += 2; continue;
+          }
+          if (ch === '√') { tokens.push({ type: 'sqrt' }); i++; continue; }
+          if (ch === 'π') { tokens.push({ type: 'sym', name: 'π' }); i++; continue; }
