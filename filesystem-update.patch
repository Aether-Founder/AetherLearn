+    
+    .water-inside {
+      bottom: 10px;
+      left: 50%;
+      transform: translateX(-50%);
+    }
+    
+    .phospholipid {
+      position: absolute;
+      cursor: pointer;
+      transition: all 0.3s ease;
+    }
+    
+    .phospholipid:hover {
