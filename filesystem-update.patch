+      --muted-foreground-hsl: 215.4 16.3% 46.9%;
+      --secondary-hsl: 210 40% 96%;
+      --secondary-foreground-hsl: 222.2 84% 4.9%;
+      --primary-hsl: 222.2 47.4% 11.2%;
+      --primary-foreground-hsl: 210 40% 98%;
+
+      /* Direct Color Values (Light Mode) */
+      --bg-color: #E8EEFD;               /* rgb(232, 238, 253) */
+      --fg-color: #020817;               /* rgb(2, 8, 23) */
+      --card-bg: #E8EEFD;                /* rgb(232, 238, 253) */
+      --card-alt: #FFFFFF;               /* rgb(255, 255, 255) */
+      --border-color: rgba(2, 8, 23, 0.18); /* #020817 at 18% */
+      --border-solid: #E2E8F0;           /* rgb(226, 232, 240) */
+      --muted-bg: #F1F5F9;               /* rgb(241, 245, 249) */
+      --muted-text: #64748B;             /* rgb(100, 116, 139) */
+      --secondary-bg: #F1F5F9;           /* rgb(241, 245, 249) */
+      --secondary-text: #020817;         /* rgb(2, 8, 23) */
+      --primary-btn-bg: #0F172A;         /* rgb(15, 23, 42) */
+      --primary-btn-hover: #1E293B;      /* rgb(30, 41, 59) */
+      --primary-btn-text: #F8FAFC;       /* rgb(248, 250, 252) */
+      --code-bg: #E2E8F0;                /* rgb(226, 232, 240) */
+      --focus-ring: rgba(15, 23, 42, 0.2);
+
+      --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
+      --font-serif: 'Cormorant Garamond', Georgia, Cambria, serif;
+      --font-mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
+    }
+
+    html.dark {
+      /* Dark Mode: Deep Midnight Navy (NOT pitch black) */
+      --background-hsl: 222.2 84% 4.9%;
+      --foreground-hsl: 210 40% 98%;
+      --card-hsl: 222.2 84% 4.9%;
+      --border-hsl: 217.2 32.6% 17.5%;
+      --border-solid-hsl: 217.2 32.6% 17.5%;
+      --muted-hsl: 217.2 32.6% 17.5%;
+      --muted-foreground-hsl: 215 20.2% 65.1%;
+      --secondary-hsl: 217.2 32.6% 17.5%;
+      --secondary-foreground-hsl: 210 40% 98%;
+      --primary-hsl: 210 40% 98%;
+      --primary-foreground-hsl: 222.2 47.4% 11.2%;
+
+      /* Direct Color Values (Dark Mode) */
+      --bg-color: #020817;               /* rgb(2, 8, 23) */
+      --fg-color: #F8FAFC;               /* rgb(248, 250, 252) */
+      --card-bg: #020817;                /* rgb(2, 8, 23) */
+      --card-alt: #0B1120;               /* rgb(11, 17, 32) */
+      --border-color: #1E293B;           /* rgb(30, 41, 59) */
+      --border-solid: #1E293B;           /* rgb(30, 41, 59) */
+      --muted-bg: #1E293B;               /* rgb(30, 41, 59) */
+      --muted-text: #94A3B8;             /* rgb(148, 163, 184) */
+      --secondary-bg: #1E293B;           /* rgb(30, 41, 59) */
+      --secondary-text: #F8FAFC;         /* rgb(248, 250, 252) */
+      --primary-btn-bg: #F8FAFC;         /* rgb(248, 250, 252) */
+      --primary-btn-hover: #E2E8F0;      /* rgb(226, 232, 240) */
+      --primary-btn-text: #020817;       /* rgb(2, 8, 23) */
+      --code-bg: #1E293B;                /* rgb(30, 41, 59) */
+      --focus-ring: rgba(248, 250, 252, 0.25);
+    }
+
+    /* ==========================================================================
+       2. BASE RESET & GLOBAL STYLES
+       ========================================================================== */
+    *, *::before, *::after {
+      box-sizing: border-box;
+      margin: 0;
+      padding: 0;
+      scrollbar-width: none;
+      -ms-overflow-style: none;
+    }
+    *::-webkit-scrollbar {
+      display: none;
+    }
+
+    html {
+      font-family: var(--font-sans);
+      color-scheme: light dark;
+      scroll-behavior: smooth;
+      background-color: var(--bg-color);
+      color: var(--fg-color);
+      transition: background-color 0.25s ease, color 0.25s ease;
+    }
+
+    body {
+      background-color: var(--bg-color);
+      color: var(--fg-color);
+      line-height: 1.6;
+      font-size: 15px;
+      -webkit-font-smoothing: antialiased;
+    }
+
+    /* Typography font assignments */
+    h1, h2, h3, h4, h5, h6, .font-serif {
+      font-family: var(--font-serif);
+      font-weight: 500;
+      letter-spacing: -0.01em;
+    }
+    .font-sans {
+      font-family: var(--font-sans);
+    }
+    .font-mono {
+      font-family: var(--font-mono);
+    }
+
+    /* Container */
+    .container-custom {
+      max-width: 1100px;
+      margin-left: auto;
+      margin-right: auto;
+      padding-left: 1.25rem;
+      padding-right: 1.25rem;
+    }
+
+    /* Cards */
+    .card-base {
+      background-color: var(--card-bg);
+      border: 1px solid var(--border-color);
+      border-radius: 6px;
+      transition: all 0.2s ease;
+    }
+
+    /* Buttons */
+    .btn {
+      display: inline-flex;
+      align-items: center;
+      justify-content: center;
+      gap: 0.5rem;
+      padding: 0.5rem 0.95rem;
+      font-size: 13px;
+      font-weight: 500;
+      font-family: var(--font-sans);
+      border-radius: 4px;
+      cursor: pointer;
+      text-decoration: none;
+      transition: all 0.15s ease;
+      border: 1px solid transparent;
+      user-select: none;
+    }
+
+    .btn-primary {
+      background-color: var(--primary-btn-bg);
+      color: var(--primary-btn-text);
+      border-color: var(--primary-btn-bg);
+    }
+    .btn-primary:hover {
+      background-color: var(--primary-btn-hover);
+      opacity: 0.95;
+    }
+
+    .btn-secondary {
+      background-color: var(--bg-color);
+      color: var(--fg-color);
+      border-color: var(--border-color);
+    }
+    .btn-secondary:hover {
+      background-color: var(--secondary-bg);
+    }
+
+    .btn-icon {
+      padding: 0.5rem;
+      border-radius: 4px;
+      border: 1px solid var(--border-color);
+      background-color: transparent;
+      color: var(--muted-text);
+      cursor: pointer;
+      display: inline-flex;
+      align-items: center;
+      justify-content: center;
+      transition: all 0.15s ease;
+    }
+    .btn-icon:hover {
+      color: var(--fg-color);
+      background-color: var(--secondary-bg);
+    }
+
+    /* Tab switcher for Style Guide sections */
+    .tab-bar {
+      display: flex;
+      gap: 0.25rem;
+      padding: 0.25rem;
+      background-color: var(--secondary-bg);
+      border: 1px solid var(--border-color);
+      border-radius: 8px;
+      overflow-x: auto;
+    }
+    .tab-btn {
+      display: inline-flex;
+      align-items: center;
+      gap: 0.4rem;
+      padding: 0.5rem 0.85rem;
+      font-size: 13px;
+      font-weight: 500;
+      border-radius: 6px;
+      border: 1px solid transparent;
+      background: transparent;
+      color: var(--muted-text);
+      cursor: pointer;
+      white-space: nowrap;
+      transition: all 0.15s ease;
+    }
+    .tab-btn:hover {
+      color: var(--fg-color);
+    }
