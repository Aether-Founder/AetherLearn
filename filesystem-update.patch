+
+  <!-- ==========================================================================
+       JAVASCRIPT INTERACTIONS (THEME, TABS, FLASHCARD, ACCORDION)
+       ========================================================================== -->
+  <script>
+    // 1. Theme Management (Light / Dark Mode)
+    const htmlEl = document.documentElement;
+    const themeBtn = document.getElementById('themeToggleBtn');
+    const sunIcon = document.getElementById('themeIconSun');
+    const moonIcon = document.getElementById('themeIconMoon');
+    const themeText = document.getElementById('themeToggleText');
+
+    function updateThemeUI(isDark) {
+      if (isDark) {
+        htmlEl.classList.add('dark');
+        htmlEl.classList.remove('light');
+        sunIcon.style.display = 'inline-block';
+        moonIcon.style.display = 'none';
+        themeText.textContent = 'Lichte Modus';
+      } else {
+        htmlEl.classList.remove('dark');
+        htmlEl.classList.add('light');
+        sunIcon.style.display = 'none';
+        moonIcon.style.display = 'inline-block';
+        themeText.textContent = 'Donkere Modus';
+      }
+    }
+
+    themeBtn.addEventListener('click', () => {
+      const isCurrentlyDark = htmlEl.classList.contains('dark');
+      updateThemeUI(!isCurrentlyDark);
+    });
+
+    // 2. Guide Tab Navigation
+    function switchGuideTab(tabId, btn) {
+      document.querySelectorAll('.guide-tab-content').forEach(el => el.style.display = 'none');
+      document.querySelectorAll('.tab-bar .tab-btn').forEach(el => el.classList.remove('active'));
+      
+      const target = document.getElementById(tabId);
+      if (target) {
+        target.style.display = 'block';
+      }
+      btn.classList.add('active');
+    }
+
+    // Initialize with first tab visible
+    document.addEventListener('DOMContentLoaded', () => {
+      const hash = window.location.hash;
+      if (hash === '#previewSection') {
+        const previewTabBtn = document.querySelectorAll('.tab-bar .tab-btn')[3];
+        if (previewTabBtn) switchGuideTab('tab-leerpagina', previewTabBtn);
+      }
+    });
+
+    // 3. Demo Flashcard Interactive State
+    const flashcardQuestions = [
+      {
+        qNum: "Opgave 1",
+        qText: "Met welke grootheid geef je aan hoeveel energie een apparaat per seconde omzet?",
+        aNum: "Uitwerking 1",
+        aText: "Het <strong>elektrisch vermogen</strong> (symbool: <span class=\"math-formula\">P</span>, eenheid: watt of <strong>W</strong>)."
+      },
+      {
+        qNum: "Opgave 2a",
+        qText: "Met welke formule bereken je het elektrisch vermogen uit spanning en stroomsterkte?",
+        aNum: "Uitwerking 2a",
+        aText: "Formule: <span class=\"math-formula\"><strong>P = U &times; I</strong></span> (Vermogen = Spanning &times; Stroomsterkte)."
+      },
+      {
+        qNum: "Opgave 3",
+        qText: "Wat is de eenheid en het symbool van capaciteit van een batterij of accu?",
+        aNum: "Uitwerking 3",
+        aText: "Het symbool is <span class=\"math-formula\"><strong>C</strong></span> en de eenheid is <strong>amp&egrave;re-uur (Ah)</strong>."
+      }
+    ];
+
+    let currentCardIndex = 0;
+    const cardEl = document.getElementById('demoFlashcard');
+    const toggleBtn = document.getElementById('fcToggleBtn');
+    const progressBar = document.getElementById('flashcardProgressBar');
+
+    function updateCardUI() {
+      const item = flashcardQuestions[currentCardIndex];
+      document.getElementById('fcQuestionNumber').textContent = item.qNum;
+      document.getElementById('fcQuestionText').innerHTML = item.qText;
+      document.getElementById('fcAnswerNumber').textContent = item.aNum;
+      document.getElementById('fcAnswerText').innerHTML = item.aText;
+      cardEl.classList.remove('flipped');
+      toggleBtn.textContent = 'Toon Uitwerking';
+      
+      const percent = ((currentCardIndex + 1) / flashcardQuestions.length) * 100;
+      progressBar.style.width = percent + '%';
+    }
+
+    function toggleDemoFlashcard() {
+      cardEl.classList.toggle('flipped');
+      const isFlipped = cardEl.classList.contains('flipped');
+      toggleBtn.textContent = isFlipped ? 'Toon Opgave' : 'Toon Uitwerking';
+    }
+
+    function nextDemoCard() {
+      currentCardIndex = (currentCardIndex + 1) % flashcardQuestions.length;
+      updateCardUI();
+    }
+
+    function prevDemoCard() {
+      currentCardIndex = (currentCardIndex - 1 + flashcardQuestions.length) % flashcardQuestions.length;
+      updateCardUI();
+    }
+
+    // Keyboard support for space and arrow keys
+    window.addEventListener('keydown', (e) => {
+      if (document.getElementById('tab-components').style.display !== 'none') {
+        if (e.code === 'Space') {
+          e.preventDefault();
+          toggleDemoFlashcard();
+        } else if (e.code === 'ArrowRight') {
+          e.preventDefault();
+          nextDemoCard();
+        } else if (e.code === 'ArrowLeft') {
+          e.preventDefault();
+          prevDemoCard();
+        }
+      }
+    });
+
+    // 4. Accordion Toggle Functions
+    function toggleAccordion(headerBtn) {
+      const item = headerBtn.closest('.accordion-item');
+      if (item) {
+        item.classList.toggle('open');
+      }
+    }
+
+    function toggleAllQuestions() {
+      const items = document.querySelectorAll('.accordion-item');
+      const anyClosed = Array.from(items).some(i => !i.classList.contains('open'));
+      items.forEach(item => {
+        if (anyClosed) {
+          item.classList.add('open');
+        } else {
+          item.classList.remove('open');
+        }
+      });
+    }
+  </script>
+</body>
+</html>
