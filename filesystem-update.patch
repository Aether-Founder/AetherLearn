+/* DP-normalisatie: zoekt de meest aannemelijke opdeling in bekende symbolen (voorkeur: laagste Z) */
+function smartNormalize(s){
+  const n = s.length, best = new Array(n+1).fill(null);
+  best[0] = { score:0, text:'' };
+  for (let i=0;i<n;i++){
+    if (!best[i]) continue;
+    const dm = /^\d+/.exec(s.slice(i));
+    if (dm){
+      const j = i + dm[0].length;
+      const c = { score: best[i].score, text: best[i].text + dm[0] };
+      if (!best[j] || c.score < best[j].score) best[j] = c;
+    }
+    for (const len of [1,2]){
+      const part = s.slice(i, i+len);
+      if (part.length < len) continue;
+      const sym = part.charAt(0).toUpperCase() + part.slice(1).toLowerCase();
+      if (EL[sym]){
