+        toggleJsonPasteModal();
+      } catch (err) {
+        alert("Invalid JSON format: " + err.message);
+      }
+    }
+
+    function handleFileUpload(e) {
+      const file = e.target.files[0];
+      if (!file) return;
+
+      const reader = new FileReader();
+      reader.onload = (event) => {
+        try {
+          const parsed = JSON.parse(event.target.result);
+          processAndOpenCustomJson(parsed, file.name.replace(/\.json$/i, ''));
+        } catch (err) {
+          alert("Error parsing uploaded JSON: " + err.message);
+        }
+      };
+      reader.readAsText(file);
+    }
+
+    function processAndOpenCustomJson(data, fallbackTitle = "Custom Set") {
+      const setObj = {
+        id: `custom-${Date.now()}`,
+        subject: "Custom Leerset",
+        siteMetadata: {
+          title: data.siteMetadata?.title || fallbackTitle,
+          description: data.siteMetadata?.description || "Loaded from custom JSON file."
+        },
+        summary: data.summary || "",
+        sections: data.sections || []
+      };
+
+      allLoadedSets.unshift(setObj);
+      renderSetsGrid();
+      openLeerset(setObj);
+    }
+
+    /* --------------------------------------------------------------------------
+       8. SCROLLSPY & SCROLL-TO-TOP OBSERVER
+       -------------------------------------------------------------------------- */
+    window.addEventListener('scroll', () => {
+      const scrollTopBtn = document.getElementById('scrollTopBtn');
+      if (window.scrollY > 350) {
+        scrollTopBtn.style.display = 'inline-flex';
+      } else {
+        scrollTopBtn.style.display = 'none';
+      }
+
+      if (document.getElementById('viewLeerset').style.display !== 'none') {
+        const sections = document.querySelectorAll('#textbookSectionsContainer section[id]');
+        const links = document.querySelectorAll('#sidebarNavLinks .sidebar-link');
