+  const w = 200, h = 170, cx = w/2, cy = h/2 + 4;
+  const n = opts.electrons ?? valenceElectrons(el) ?? 0;
+  const R = 46;
+  const dirs = [[0,-1],[1,0],[0,1],[-1,0]];
+  let s = '';
+  let left = n, placed = [];
+  // eerst één elektron per zijde, daarna paren
+  for (let pass=0; pass<2 && left>0; pass++){
+    for (let d=0; d<4 && left>0; d++){
+      placed.push({ d, pair: pass===1 });
+      left--;
+    }
+  }
+  placed.forEach(p => {
+    const [ux,uy] = dirs[p.d];
+    const bx = cx + ux*R, by = cy + uy*R;
+    const perp = [ -uy, ux ];
+    const off = p.pair ? 6 : 0;
+    s += `<circle class="lp-dot" cx="${f(bx - perp[0]*off)}" cy="${f(by - perp[1]*off)}" r="4"/>`;
+    if (p.pair) s += `<circle class="lp-dot" cx="${f(bx + perp[0]*off)}" cy="${f(by + perp[1]*off)}" r="4"/>`;
+  });
+  s += `<text class="atom-label" x="${cx}" y="${f(cy+11)}" text-anchor="middle">${el.sym}</text>`;
+  if (opts.charge) s += `<text class="charge" x="${f(cx+R+8)}" y="${f(cy-R+6)}">${esc(opts.charge)}</text>`;
+  if (opts.brackets) s += `<path class="bracket" d="M${cx-R-18},${cy-R-14} h-10 v${2*R+28} h10 M${cx+R+18},${cy-R-14} h10 v${2*R+28} h-10"/>`;
+  return svgWrap(s, w, h, `Lewis-symbool van ${el.name} met ${n} valentie-elektronen.`);
+}
+
+/* ---------- stappen voor een covalent molecuul ---------- */
+function lewisSteps(model){
+  const { list, bonds, centerIdx, totalVE, parsed } = model;
+  const steps = [];
+  const central = list[centerIdx];
+  const name = molName(parsed);
+
+  steps.push({
+    kicker:'De formule lezen',
+    title:`Wat staat er in ${fmtFormula(parsed.text)}?`,
+    visual:'',
+    table: `<table class="chem-table"><thead><tr><th>Element</th><th>Naam</th><th class="num">Aantal atomen</th><th class="num">Groep</th></tr></thead><tbody>${
+      parsed.atoms.map(a => `<tr><td class="sym">${a.el.sym}</td><td>${a.el.name}</td><td class="num">${a.count}</td><td class="num">${a.el.group||'—'}</td></tr>`).join('')
+    }</tbody></table>`,
+    what:`De formule bevat ${parsed.total} atoom/atomen: ${parsed.atoms.map(a => `${a.count} × ${a.el.sym}`).join(', ')}.`,
+    why:'Voordat je tekent, moet je weten welke atomen er zijn en hoeveel. Een structuurformule laat zien hoe die atomen met elkaar verbonden zijn.',
+    change:`We weten met welke bouwstenen we werken${name ? ` — dit is ${name}` : ''}.`
+  });
+
+  // valentie-elektronen
+  const symRow = list.filter((a,i) => list.findIndex(b=>b.el.sym===a.el.sym)===i);
+  steps.push({
+    kicker:'Valentie-elektronen',
+    title:'Hoeveel elektronen kunnen er delen?',
+    visual:`<div style="display:flex;flex-wrap:wrap;gap:.5rem;justify-content:center;width:100%">${
+      symRow.map(a => `<figure style="margin:0;text-align:center">${lewisSymbolSVG(a.el)}<figcaption style="color:var(--muted-foreground);font-size:12px">${a.el.sym} · groep ${a.el.group} · ${valenceElectrons(a.el)} e⁻</figcaption></figure>`).join('')
+    }</div>`,
+    table:`<table class="chem-table"><thead><tr><th>Element</th><th class="num">Groep</th><th class="num">Valentie-e⁻ per atoom</th><th class="num">Aantal atomen</th><th class="num">Totaal</th></tr></thead><tbody>${
+      parsed.atoms.map(a => { const v = valenceElectrons(a.el); return `<tr><td class="sym">${a.el.sym}</td><td class="num">${a.el.group}</td><td class="num">${v}</td><td class="num">${a.count}</td><td class="num">${v*a.count}</td></tr>`; }).join('')
+    }<tr><td colspan="4"><b>Totaal aantal valentie-elektronen</b></td><td class="num"><b>${totalVE}</b></td></tr></tbody></table>`,
+    what:`We tellen alle valentie-elektronen: ${totalVE} in totaal.`,
+    why:`Het groepsnummer vertelt hoeveel elektronen er in de buitenste schil staan. Alleen díe elektronen doen mee aan bindingen.`,
+    change:`We hebben een "elektronenbudget" van ${totalVE} elektronen = ${totalVE/2} paren.`
+  });
+
+  // covalenties
+  steps.push({
+    kicker:'Covalentie',
+    title:'Hoeveel bindingen wil elk atoom?',
+    visual:'',
+    table:`<table class="chem-table"><thead><tr><th>Element</th><th class="num">Valentie-e⁻</th><th class="num">Covalentie</th><th>Reden</th></tr></thead><tbody>${
+      symRow.map(a => {
+        const v = valenceElectrons(a.el), c = covalency(a.el);
+        const whyC = a.el.sym === 'H'
+          ? 'H wil 2 elektronen (duplet) → 1 binding'
+          : `Octet: 8 − ${v} = ${c} bindingen`;
+        return `<tr><td class="sym">${a.el.sym}</td><td class="num">${v}</td><td class="num"><b>${c}</b></td><td>${whyC}</td></tr>`;
+      }).join('')
+    }</tbody></table>`,
+    what:`We zetten de covalentie op: ${symRow.map(a => `${a.el.sym} = ${covalency(a.el)}`).join(', ')}.`,
+    why:'Elk atoom streeft naar een volle buitenste schil: 2 elektronen voor waterstof (duplet), 8 voor de rest (octetregel). Het aantal bindingen dat daarvoor nodig is, heet de covalentie.',
+    change:'Nu weten we hoeveel "haakjes" elk atoom heeft om te verbinden.'
+  });
+
+  // skelet
+  steps.push({
+    kicker:'Skelet',
+    title:'Het centrale atoom en de enkelvoudige bindingen',
+    visual: lewisSVG(model, { singleBonds:true, showLonePairs:false }),
+    what:`${central.el.sym} komt in het midden, daaromheen de andere atomen. We tekenen eerst alleen enkelvoudige bindingen (${bonds.length} stuks = ${bonds.length*2} elektronen).`,
+    why:`Het minst elektronegatieve atoom komt centraal (${central.el.sym}, EN = ${String(central.el.en).replace('.',',')}). Waterstof en halogenen staan altijd aan de buitenkant: die hebben maar één binding nodig.`,
+    change:`De atomen zitten aan elkaar vast. Er zijn nog ${totalVE - bonds.reduce((s,b)=>s+2*b.order,0)} elektronen over om te verdelen.`
+  });
+
+  // vrije paren
+  const lpTotal = list.reduce((s,a)=>s+a.lp,0);
+  steps.push({
+    kicker:'Octetregel',
+    title:'De overgebleven elektronen verdelen',
+    visual: lewisSVG(model, { singleBonds:true, showLonePairs:true }),
+    what:`We plaatsen ${lpTotal} vrije elektronenparen (${lpTotal*2} elektronen) om de atomen heen.`,
+    why:'Eerst krijgen de buitenste atomen een vol octet (waterstof een duplet), daarna het centrale atoom. Een vrij paar telt mee voor het octet maar verbindt niets.',
+    change:`Alle ${totalVE} valentie-elektronen zijn nu geplaatst: ${bonds.length*2} in bindingen en ${lpTotal*2} als vrije paren.`
+  });
+
+  // meervoudige bindingen (alleen indien nodig)
+  const multi = bonds.filter(b => b.order > 1);
+  if (multi.length){
+    steps.push({
+      kicker:'Octetcontrole',
+      title:'Het octet klopt nog niet → meervoudige binding',
+      visual: lewisSVG(model, { showLonePairs:true, highlightBonds: bonds.map((b,i)=>b.order>1?i:-1).filter(i=>i>=0) }),
+      what:`${multi.map(b => `tussen ${list[b.a].el.sym} en ${list[b.b].el.sym} wordt de binding een ${b.order===2?'dubbelbinding':'drievoudige binding'}`).join(', ')}.`,
+      why:`Met alleen enkelvoudige bindingen komt ${central.el.sym} niet aan 8 elektronen. We geven een vrij elektronenpaar van de buur "extra" uit als binding: zo halen beide atomen hun octet zonder dat er elektronen bijkomen.`,
+      change:`Het totaal aantal elektronen blijft ${totalVE}, maar de verdeling verandert: minder vrije paren, sterkere bindingen.`
+    });
+  }
+
+  // VSEPR
+  const doms = bonds.filter(b=>b.a===centerIdx||b.b===centerIdx).length + central.lp;
+  const shapeName = ({2:'lineair',3:'trigonaal planair',4:'tetraëdrisch',5:'trigonaal bipiramidaal',6:'octaëdrisch'})[doms] || 'tetraëdrisch';
+  steps.push({
+    kicker:'VSEPR',
+    title:`De ruimtelijke bouw: ${shapeName}`,
+    visual: lewisSVG(model, { showLonePairs:true, showAngles:true }),
+    what:`Rond ${central.el.sym} zitten ${doms} elektronendomeinen (${bonds.filter(b=>b.a===centerIdx||b.b===centerIdx).length} bindingen + ${central.lp} vrije paren). De hoek tussen de domeinen is ${String(Math.round(central.domainAngle)).replace('.',',')}°.`,
+    why:'Elektronenparen zijn allemaal negatief en stoten elkaar af. Ze gaan zo ver mogelijk uit elkaar staan: 2 domeinen → 180°, 3 → 120°, 4 → 109,5°.',
+    change:`De vlakke tekening wordt een ruimtelijk model. Vrije paren nemen iets meer ruimte in, waardoor bijvoorbeeld H₂O gebogen is.`
+  });
+
+  steps.push({
+    kicker:'Eindresultaat',
+    title:`De structuurformule van ${fmtFormula(parsed.text)}${name?` (${name})`:''}`,
+    final:true,
+    model:'lewis',
+    visual:'',
+    what:`Dit is de structuurformule. Elke streep is een binding (2 gedeelde elektronen), elke punt een vrij elektron.`,
+    why:`Controle: ${bonds.length} bindingen × 2 + ${lpTotal} vrije paren × 2 = ${bonds.length*2 + lpTotal*2} elektronen. Dat moet gelijk zijn aan het totaal van ${totalVE} valentie-elektronen.`,
+    change:`Het molecuul is compleet getekend en elk atoom heeft zijn octet (of duplet).`
+  });
+
+  return steps;
+}
+
+/* ---------- los atoom / edelgas / metaal / ionair ---------- */
+function atomSteps(model){
+  const el = model.el;
+  const ve = valenceElectrons(el);
+  const steps = [{
+    kicker:'Los atoom',
+    title:`Het Lewis-symbool van ${el.name}`,
+    visual: lewisSymbolSVG(el),
+    what:`We tekenen het symbool met ${ve === null ? 'de' : ve} valentie-elektronen${ve === null ? ' (wisselend bij overgangsmetalen)' : ''} als stippen eromheen.`,
+    why:'Een structuurformule is er alleen voor moleculen of ionroosters. Van een los atoom teken je het Lewis-symbool: symbool + valentie-elektronen.',
+    change:`Je ziet in één oogopslag hoeveel bindingen ${el.sym} kan aangaan.`
+  }];
+  if (el.cat === 'o' || isMetalEl(el)){
+    steps.push({
+      kicker:'Soort stof',
+      title:`${el.name} is een ${CAT_LABEL[el.cat]}`,
+      visual:'',
+      what:`Metalen teken je niet met een structuurformule. ${el.name} vormt een ${el.cat==='o'?'metaalrooster':'metaalrooster'} met een "zee" van losse elektronen, of het vormt ionen.`,
+      why:`Bij metalen zitten de valentie-elektronen niet vast tussen twee atomen, zoals bij een covalente binding. Daarom bestaat er geen molecuul ${el.sym}₂ met een vaste structuurformule.`,
+      change:`In plaats van een structuurformule gebruik je: ${el.sym} als metaalrooster, of het ion ${el.sym}${ionCharge(el) ? `<sup>${ionCharge(el)}+</sup>` : 'met variabele lading'}.`
+    });
+    if (ionCharge(el)){
+      steps.push({
+        kicker:'Ionvorming',
+        title:`${el.sym} → ${el.sym}<sup>${ionCharge(el)}+</sup> + ${ionCharge(el)} e⁻`,
+        visual: lewisSymbolSVG(el, { charge:`${ionCharge(el)}+`, brackets:true, electrons:0 }),
+        what:`Het atoom staat ${ionCharge(el)} elektron(en) af en wordt een positief ion (kation).`,
+        why:`Door elektronen af te staan krijgt het ion dezelfde elektronenconfiguratie als het edelgas ervoor — dat is energetisch veel gunstiger.`,
+        change:`De buitenste schil verdwijnt: het ion heeft nu een volle schil eronder.`
+      });
+    }
+  }
+  steps.push({
+    kicker:'Eindresultaat',
+    title:`Het Lewis-symbool van ${el.name}`,
+    final:true,
+    model:'lewis-atom',
+    el,
+    visual:'',
+    what:`Dit is de "structuurformule" van één los ${el.sym}-atoom.`,
+    why:`${el.cat === 'e' ? 'Edelgassen hebben al een volle buitenste schil en vormen dus vrijwel geen bindingen.' : `Wil je een echte structuurformule, vul dan een molecuul in (bijvoorbeeld ${el.sym === 'O' ? 'H2O of O2' : el.sym === 'C' ? 'CH4 of CO2' : el.sym === 'H' ? 'H2O of H2' : 'een formule met dit element'}).`}`,
+    change:'Je kunt nu zien hoeveel bindingen dit atoom maximaal aangaat.'
+  });
+  return steps;
+}
+
+function nobleSteps(model){
+  const el = model.el;
+  return [{
+    kicker:'Edelgas',
+    title:`${el.name} heeft al een volle schil`,
+    visual: lewisSymbolSVG(el),
+    what:`${el.sym} heeft ${valenceElectrons(el)} valentie-elektronen: de buitenste schil is vol (${el.sym === 'He' ? '2, duplet' : '8, octet'}).`,
+    why:'Een volle buitenste schil is de meest stabiele situatie. Daarom hoeft dit atoom niets te delen, af te staan of op te nemen.',
+    change:'Er is geen binding nodig: edelgassen bestaan als losse atomen.'
+  },{
+    kicker:'Eindresultaat',
+    title:`Het atoom ${el.sym} tekent zichzelf`,
+    final:true,
+    model:'lewis-atom',
+    el,
+    visual:'',
+    what:'Een edelgas teken je als los atoom met acht (bij helium twee) stippen.',
+    why:'Juist dóór die volle schil zijn edelgassen onreactief en bestaan ze niet als moleculen.',
+    change:'Geen bindingen, geen vrije paren die nog verplaatst kunnen worden.'
+  }];
+}
+
+function ionicSteps(model){
+  const { parsed, metals, nonmetals } = model;
+  const distinctNonmetals = nonmetals.filter((a,i) => nonmetals.findIndex(b=>b.el.sym===a.el.sym)===i);
+  if (distinctNonmetals.length > 1){
+    throw new ChemError(`Deze stof bevat waarschijnlijk een samengesteld ion (zoals CO₃²⁻, SO₄²⁻, NO₃⁻ of OH⁻). Die teken ik nog niet; vul eerst het losse ion of een eenvoudigere stof in.`);
+  }
+  const metal = metals[0].el, nonmetal = nonmetals[0].el;
+  const mCount = metals.reduce((s,a)=>s+a.count,0);
+  const nCount = nonmetals.reduce((s,a)=>s+a.count,0);
+  const an = anionCharge(nonmetal);
+  if (an === null) throw new ChemError(`Van ${nonmetal.name} kan ik de ionlading niet betrouwbaar afleiden.`);
+  let mCharge = ionCharge(metal);
+  let inferred = false;
+  if (mCharge === null){
+    const total = -an*nCount;
+    if (total % mCount !== 0) throw new ChemError('De ladingen van deze ionaire stof komen niet uit. Controleer de formule.');
+    mCharge = total / mCount; inferred = true;
+  }
+  if (mCharge*mCount + an*nCount !== 0){
+    throw new ChemError(`De ladingen komen niet uit: ${mCount} × ${mCharge}+ en ${nCount} × ${an} geeft geen neutrale stof. Controleer de formule.`);
+  }
+  const dEN = Math.abs(nonmetal.en - metal.en);
+  const steps = [];
+
+  steps.push({
+    kicker:'Soort binding bepalen',
+    title:`${metal.name} + ${nonmetal.name} → ionbinding`,
+    visual:'',
+    what:`Dit is een verbinding van een ${CAT_LABEL[metal.cat]} met een ${CAT_LABEL[nonmetal.cat]}. Het elektronegativiteitsverschil is ${String(dEN).replace('.',',')}.`,
+    why:`Bij een verschil groter dan ongeveer 1,7 trekken de atomen niet samen aan één elektronenpaar, maar draagt het metaal elektronen over. Dan ontstaat een ionrooster, geen molecuul — en dus geen structuurformule.`,
+    change:`We tekenen hierna de ionen met hun lading in plaats van gedeelde elektronenparen.`
+  });
+
+  steps.push({
+    kicker:'Elektronenoverdracht',
+    title:`${metal.sym} staat ${mCharge} elektronen af, ${nonmetal.sym} neemt ze op`,
+    visual:`<div style="display:flex;flex-wrap:wrap;gap:1rem;justify-content:center;align-items:center;width:100%">
+      ${lewisSymbolSVG(metal, { charge:`${mCharge}+`, brackets:true, electrons:0 })}
+      <span style="font-size:26px;color:var(--muted-foreground)">→</span>
+      ${lewisSymbolSVG(nonmetal, { charge:`${an}−`, brackets:true, electrons: valenceElectrons(nonmetal) + (-an) })}
+    </div>`,
+    what:`Elk ${metal.sym}-atoom staat ${mCharge} elektron(en) af en wordt ${metal.sym}<sup>${mCharge}+</sup>. Elk ${nonmetal.sym}-atoom neemt ${-an} elektron(en) op en wordt ${nonmetal.sym}<sup>${an}−</sup>.`,
+    why:`Beide ionen krijgen zo de elektronenconfiguratie van een edelgas: een volle buitenste schil. ${inferred ? `Omdat ${metal.name} meerdere ladingen kan hebben, leid ik uit de formule af dat het hier om ${mCharge}+ gaat.` : ''}`,
+    change:'Er zijn geen gedeelde elektronenparen meer: de binding is nu puur elektrostatische aantrekking.'
+  });
+
+  steps.push({
+    kicker:'Verhouding',
+    title:`Waarom ${fmtFormula(parsed.text)} en niet iets anders?`,
+    visual:'',
+    table:`<table class="chem-table"><thead><tr><th>Ion</th><th class="num">Lading</th><th class="num">Aantal</th><th class="num">Totale lading</th></tr></thead><tbody>
+      <tr><td class="sym">${metal.sym}<sup>${mCharge}+</sup></td><td class="num">${mCharge}+</td><td class="num">${mCount}</td><td class="num">${mCount*mCharge}+</td></tr>
+      <tr><td class="sym">${nonmetal.sym}<sup>${an}−</sup></td><td class="num">${an}−</td><td class="num">${nCount}</td><td class="num">${nCount*an}−</td></tr>
+      <tr><td colspan="3"><b>Netto</b></td><td class="num"><b>0</b></td></tr></tbody></table>`,
+    what:`${mCount} × ${mCharge}+ = ${mCount*mCharge}+ en ${nCount} × ${an} = ${nCount*an}. Samen precies 0.`,
+    why:'Een ionrooster is elektrisch neutraal. De verhouding in de formule is dus niet willekeurig: die volgt uit de ladingen van de ionen.',
+    change:`De formule ${fmtFormula(parsed.text)} is een verhoudingsformule, geen molecuulformule.`
+  });
+
+  steps.push({
+    kicker:'Eindresultaat',
+    title:`Geen structuurformule, maar een ionrooster`,
+    final:true,
+    model:'ionic',
+    metal, nonmetal, mCharge, an,
+    visual:'',
+    what:`Deze stof bestaat uit ${metal.sym}<sup>${mCharge}+</sup> en ${nonmetal.sym}<sup>${an}−</sup> in de verhouding ${mCount} : ${nCount}.`,
+    why:'In een ionrooster wisselen positieve en negatieve ionen elkaar in drie dimensies af. Er is geen "los molecuul" met een vaste structuurformule.',
+    change:`Je schrijft daarom: ${fmtFormula(parsed.text)}${molName(parsed) ? ` — ${molName(parsed)}` : ''} als verhoudingsformule, en de ionen apart met hun lading.`
+  });
+  return steps;
+}
+
+function metalSteps(model){
+  const el = model.atoms[0].el;
+  return [{
+    kicker:'Soort stof',
+    title:`${el.name} is een ${CAT_LABEL[el.cat]}`,
+    visual:'',
+    what:`${el.sym} vormt een metaalrooster: positieve ionen in een zee van losse valentie-elektronen.`,
+    why:'Bij metalen horen de valentie-elektronen niet bij één atoom of één binding. Daarom bestaat er geen structuurformule van een metaal.',
+    change:'Je tekent in plaats daarvan het rooster, of je geeft het ion aan: ' + (ionCharge(el) ? `${el.sym}<sup>${ionCharge(el)}+</sup>` : `${el.sym} met variabele lading`) + '.'
+  },{
+    kicker:'Eindresultaat',
+    title:`${el.sym}: metaalrooster`,
+    final:true,
+    model:'metal',
+    el,
+    visual:'',
+    what:`Voor ${el.name} is er geen structuurformule te tekenen.`,
+    why:`Die vrije elektronen verklaren wel de eigenschappen: elektrische geleiding, warmtegeleiding en vervormbaarheid.`,
+    change:'Vul een niet-metaal of een molecuul in (zoals H2O of CO2) om een echte structuurformule te zien.'
+  }];
+}
+
+/* ============================================================
+   INFO-PANEEL (direct bij invoer)
+   ============================================================ */
+function renderInfo(parsed){
+  const panel = document.getElementById('infoPanel');
+  if (!parsed){ panel.innerHTML = '<p class="empty-note">Nog niets ingevuld.</p>'; return; }
+
+  if (isSingleElement(parsed)){
+    const el = parsed.atoms[0].el;
+    const N = el.A - el.Z;
+    const ve = valenceElectrons(el);
+    const cov = covalency(el);
+    panel.innerHTML = `
+      <div class="info-grid">
+        <div class="info-card"><span class="k">Atoomnummer Z</span><span class="v">${el.Z}</span></div>
+        <div class="info-card"><span class="k">Massagetal A</span><span class="v">${el.A}</span></div>
+        <div class="info-card"><span class="k">Protonen</span><span class="v">${el.Z}<small> p⁺</small></span></div>
+        <div class="info-card"><span class="k">Neutronen</span><span class="v">${N}<small> n⁰</small></span></div>
+        <div class="info-card"><span class="k">Elektronen</span><span class="v">${el.Z}<small> e⁻</small></span></div>
+      </div>
+      <ul class="calc-list">
+        <li><span class="tag">protonen</span><span>Het atoomnummer <b>is</b> het aantal protonen: Z = ${el.Z} → <b>${el.Z} protonen</b>. Dit getal bepaalt welk element het is.</span></li>
+        <li><span class="tag">neutronen</span><span>Neutronen = massagetal − atoomnummer = A − Z = ${el.A} − ${el.Z} = <b>${N} neutronen</b>. Het massagetal is het afgeronde gemiddelde van alle isotopen.</span></li>
+        <li><span class="tag">elektronen</span><span>Een atoom is elektrisch neutraal, dus aantal elektronen = aantal protonen = <b>${el.Z} elektronen</b>.</span></li>
+        <li><span class="tag">schillen</span><span>Verdeeld over de schillen: <b>${shellString(el.Z)}</b>${CONFIG_EXCEPTION.has(el.Z) ? ' (let op: dit element wijkt af van het opbouwprincipe)' : ''}.</span></li>
