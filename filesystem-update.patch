+    }
+    @media (min-width: 1024px) {
+      .tw-sidebar { width: 250px; }
+    }
+    @media (min-width: 1280px) {
+      .tw-sidebar { width: 280px; }
+    }
+
+    /* Sidebar inner sticky column */
+    .tw-sidebar-inner {
