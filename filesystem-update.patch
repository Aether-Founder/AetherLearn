+      s += `<text class="angle-text" x="${f(a.x+(r+18)*Math.cos(mid))}" y="${f(a.y+(r+18)*Math.sin(mid))}" text-anchor="middle">${String(Math.round(a.domainAngle)).replace('.',',')}°</text>`;
+    }
+  }
+  // vrije elektronenparen
+  if (state.showLonePairs !== false){
+    list.forEach(a => a.slots.forEach(sl => {
+      if (sl.type !== 'lp') return;
