+export function Meter({ value }: { value: number }) {
+  return (
+    <div className="h-[3px] w-full overflow-hidden rounded-full bg-secondary">
+      <div
+        className="h-full rounded-full bg-foreground/70 transition-all"
+        style={{ width: `${Math.max(value, 2)}%` }}
+      />
+    </div>
+  );
+}
