+    }
+    
+    .head {
+      width: 30px;
+      height: 30px;
+      background: linear-gradient(135deg, #ff6b6b, #ee5a5a);
+      border-radius: 50%;
+      position: relative;
+    }
+    
+    .tails {
+      position: absolute;
+      top: 25px;
+      left: 5px;
+      width: 20px;
+    }
+    
+    .tail {
+      width: 8px;
+      height: 40px;
+      background: linear-gradient(to bottom, #feca57, #ff9f43);
+      border-radius: 4px;
+      position: absolute;
+    }
+    
+    .tail:first-child {
+      left: 0;
