+      --muted-foreground: #64748B;        /* rgb(100, 116, 139) */
+      --secondary: #F1F5F9;                /* rgb(241, 245, 249) */
+      --secondary-foreground: #020817;     /* rgb(2, 8, 23) */
+      --primary: #3B82F6;                  /* rgb(59, 130, 246) blue-500 accent (old-tw-page) */
+      --primary-foreground: #FFFFFF;       /* white text on blue accent */
+      --primary-hover: #2563EB;            /* rgb(37, 99, 235) blue-600 hover */
+      --code-bg: #E2E8F0;                  /* rgb(226, 232, 240) */
+      --focus-ring: rgba(59, 130, 246, 0.25);
+
+      --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
+      --font-serif: 'Cormorant Garamond', Georgia, Cambria, serif;
+      --font-mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Monaco, monospace;
+    }
+
+    html.dark {
+      /* Dark Mode: Deep Midnight Navy (Never pitch black) */
+      --background: #020817;               /* rgb(2, 8, 23) */
+      --foreground: #F8FAFC;               /* rgb(248, 250, 252) */
+      --card: #020817;                     /* rgb(2, 8, 23) */
+      --border: #1E293B;                   /* rgb(30, 41, 59) */
+      --border-solid: #1E293B;             /* rgb(30, 41, 59) */
+      --muted: #1E293B;                    /* rgb(30, 41, 59) */
+      --muted-foreground: #94A3B8;        /* rgb(148, 163, 184) */
+      --secondary: #1E293B;                /* rgb(30, 41, 59) */
+      --secondary-foreground: #F8FAFC;     /* rgb(248, 250, 252) */
+      --primary: #F8FAFC;                  /* rgb(248, 250, 252) */
+      --primary-foreground: #020817;       /* rgb(2, 8, 23) */
+      --primary-hover: #E2E8F0;            /* rgb(226, 232, 240) */
+      --code-bg: #1E293B;                  /* rgb(30, 41, 59) */
+      --focus-ring: rgba(248, 250, 252, 0.2);
+    }
+
+    /* ==========================================================================
+       2. RESET & CORE STYLING
+       ========================================================================== */
+    *, *::before, *::after {
+      box-sizing: border-box;
+      margin: 0;
+      padding: 0;
+      scrollbar-width: none;
+      -ms-overflow-style: none;
