+  list.forEach((a,i) => {
+    const hl = state.highlightAtoms && state.highlightAtoms.includes(i);
+    s += `<text class="atom-label${hl?' hl':''}" x="${f(a.x)}" y="${f(a.y+9)}" text-anchor="middle">${a.el.sym}</text>`;
+  });
